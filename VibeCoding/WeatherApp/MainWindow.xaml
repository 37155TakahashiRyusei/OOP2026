<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="天気予報"
        Height="600"
        Width="400">

    <Grid>
        <StackPanel Margin="20">

            <TextBlock Text="現在の天気"
               FontSize="24"
               HorizontalAlignment="Center"/>

            <TextBlock x:Name="WeatherText"
               FontSize="18"
               Margin="0,10"/>

            <TextBlock x:Name="TemperatureText"
               FontSize="18"
               Margin="0,10"/>

            <TextBlock x:Name="HumidityText"
               FontSize="18"
               Margin="0,10"/>

            <TextBlock x:Name="WindText"
               FontSize="18"
               Margin="0,10"/>

            <TextBlock Text="7日間予報"
           FontSize="20"
           Margin="0,20,0,10"/>

            <ListBox x:Name="ForecastList"
         Height="150"/>

            <Button Content="取得"
            Click="GetWeather_Click"
            Height="40"/>

        </StackPanel>
    </Grid>
</Window>
